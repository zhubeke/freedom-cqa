NODE_ENV=production
LOG_LEVEL=info
MONGODB_ROOT_USERNAME=cqa
MONGODB_ROOT_PASSWORD=cqa_local_password
MONGODB_DATABASE=cqa
MONGODB_URI=mongodb://cqa:cqa_local_password@mongodb:27017/cqa?authSource=admin
REDIS_PASSWORD=cqa_local_password
REDIS_URL=redis://:cqa_local_password@redis:6379/0
REDPANDA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=cqa-api
KAFKA_CONSUMER_GROUP_ID=cqa-pipeline-worker-v1
FASTIFY_HOST=0.0.0.0
FASTIFY_PORT=3000
BACKEND_PORT=3000
WEB_PORT=8080
VITE_API_BASE_URL=/api
VITE_ROUTER_BASE=/
CQA_TEAM_NAME=
CQA_LLM_PROVIDER=workers_ai
CQA_LLM_ENDPOINT=
CLOUDFLARE_ACCOUNT_ID=replace_with_account_id
CLOUDFLARE_API_TOKEN=replace_with_newly_rotated_token
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CQA_LLM_TIMEOUT_MS=60000
CQA_LLM_MAX_CONCURRENCY=4
CQA_LLM_MAX_RETRIES=2
CQA_LLM_MIN_REQUEST_INTERVAL_MS=0
CQA_BATCH_MAX_CONCURRENCY=2
CQA_AUDIO_CONSUMER_GROUP=cqa-audio-worker-v1
CQA_AUDIO_ALLOWED_HOSTS=ec88f21f1accecf38e20095a9fe175.a5.environment.api.powerplatform.com
CQA_AUDIO_MAX_DOWNLOAD_BYTES=104857600
CQA_AUDIO_DOWNLOAD_TIMEOUT_SECONDS=30
