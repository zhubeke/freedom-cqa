NODE_ENV=production
LOG_LEVEL=info
MONGODB_ROOT_USERNAME=cqa
MONGODB_ROOT_PASSWORD=cqa_local_password
MONGODB_DATABASE=cqa
MONGODB_URI=mongodb://cqa:cqa_local_password@mongodb:27017/cqa?authSource=admin
REDIS_PASSWORD=cqa_local_password
REDIS_URL=redis://:cqa_local_password@redis:6379/0
REDPANDA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=cqa-api
KAFKA_CONSUMER_GROUP_ID=cqa-pipeline-worker-v1
FASTIFY_HOST=0.0.0.0
FASTIFY_PORT=3000
BACKEND_PORT=3000
WEB_PORT=8080
VITE_API_BASE_URL=/api
VITE_ROUTER_BASE=/
